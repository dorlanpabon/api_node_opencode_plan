# Servidor
PORT=3000
NODE_ENV=development

# MySQL (XAMPP por defecto: usuario root sin clave)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=api_auth_db

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# CORS: origen permitido (coma para varios). * = cualquiera (solo dev)
CORS_ORIGIN=*
